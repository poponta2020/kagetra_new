[Unit]
Description=Kagetra annual-registration-renewal reminders (年度確認: reconcile + 未回答者リマインド作成)
After=network.target postgresql.service
Documentation=https://github.com/poponta2020/kagetra_new/blob/main/docs/deploy/annual-registration-renewal.md

[Service]
# Type=oneshot — idempotent batch job. `(renewal_id, kind='reminder', target_date)`
# の未取消行が既にあれば作り直さない（同日再実行は安全）。reconcile も CAS な
# UPDATE のみで、同日再実行しても副作用が積み増えない。
Type=oneshot

# Same dedicated system user as the other kagetra services.
User=kagetra
Group=kagetra

WorkingDirectory=/opt/kagetra

# Required env: DATABASE_URL *and* PUBLIC_BASE_URL. リマインドの本文に S1
# （/renewal）の絶対 URL を載せるため PUBLIC_BASE_URL が要る（未設定だと
# 作成しようとした時点で例外になり exit 1 する）。LINE_CHAT_WORKER_TOKEN は
# このバッチ自体は使わない（match-tracker 側のワーカーが読む env）が、同じ
# .env.production にまとめて置く。
EnvironmentFile=/opt/kagetra/.env.production

# NOTE: `pnpm --filter @kagetra/web exec` runs the command with cwd set to the
# package directory (apps/web), NOT WorkingDirectory. So `tsx scripts/...`
# resolves to apps/web/scripts/renewal-daily.ts. WorkingDirectory is only the
# repo root from which pnpm discovers the workspace. This mirrors the
# production-running kagetra-lifecycle-reminders.service.
ExecStart=/usr/bin/corepack pnpm --filter @kagetra/web exec tsx scripts/renewal-daily.ts --reminders

StandardOutput=journal
StandardError=journal

# Bounded: reconcile is a couple of UPDATEs, reminder creation resolves display
# names for at most a few dozen unanswered members. Cap at 10 min to catch a
# runaway query/API call.
TimeoutStartSec=600
TimeoutStopSec=30
