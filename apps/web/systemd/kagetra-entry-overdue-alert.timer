[Unit]
Description=Run kagetra entry-overdue alert once daily at 07:00 JST
Documentation=https://github.com/poponta2020/kagetra_new/blob/main/docs/deploy/entry-overdue-alert.md
Requires=kagetra-entry-overdue-alert.service

[Timer]
# 07:00 JST — deliberately NOT the 00:00 lifecycle-reminders slot: this alert
# goes to the admin's personal LINE, and a nightly push would buzz their phone
# every midnight (requirements §3.2.1). systemd evaluates OnCalendar in the
# host's local time, which the deploy doc fixes to Asia/Tokyo.
OnCalendar=*-*-* 07:00:00
AccuracySec=5min

# Catch up after host downtime — a late alert is better than a missed one. The
# alert has no once-ever log, so a catch-up run simply re-sends today's summary.
Persistent=true

Unit=kagetra-entry-overdue-alert.service

[Install]
WantedBy=timers.target
