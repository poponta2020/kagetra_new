+// DESIGN-PROTO: つらいケース再現用。長い大会名 + 大人数 + 3〜4文字姓を多めに。
+const LONG_EVENT: HomeTimelineEvent = {
+  eventId: 950,
+  displayName: '全道かるた選手権大会ABCDE',
+  eventDate: '2026-08-02',
+  venue: '道立総合スポーツセンター 第1〜第4競技場',
