+
+export const dynamic = 'force-dynamic'
+
+/**
+ * 申込管理ボード（管理者専用）。
+ * 要件: docs/features/entry-management/requirements.md
+ */
+export default async function EntryManagementPage() {
+  const session = await auth()
+  // DESIGN-PROTO: プロトタイプは未ログインでも開けるようにする（この worktree
+  // 限定・実装時はこのガードを下の形に戻す）。
+  //   if (!session || (session.user?.role !== 'admin' && session.user?.role !== 'vice_admin')) redirect('/403')
+  if (session && session.user?.role !== 'admin' && session.user?.role !== 'vice_admin') {
+    redirect('/403')
+  }
+
+  // JST today。events の日付列は YYYY-MM-DD なので辞書順比較で正しい。
+  const todayStr = new Date().toLocaleDateString('sv-SE', {
+    timeZone: 'Asia/Tokyo',
+  })
+
+  // DESIGN-PROTO: ダミーデータ。実装時は以下の実クエリへ置換する。
+  //   1. events を母集団条件で取得（event_date >= today / status != 'cancelled'
+  //      / kind = 'individual'）
+  //   2. event_attendances の attend=true 件数を inArray で 1 クエリ一括集計
+  //   3. tournament_entry_rosters の確定名簿有無（roster_type='confirmed'
+  //      かつ superseded_at IS NULL）を inArray で 1 クエリ一括取得
+  const items = protoItems(todayStr)
+
+  return (
+    <div className="flex flex-col gap-4">
+      <h1 className="font-display text-xl font-bold text-ink">申込管理</h1>
+      <EntryBoardClient items={items} todayStr={todayStr} />
+    </div>
+  )
+}
